{
  "name": "arivu-test-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arivu Test Platform — in-house QA orchestration, dashboard, and reports",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "catalog:sync": "node scripts/generate-load-perf-scenarios.mjs && node catalog/sync.mjs",
    "perf:scenarios": "node scripts/generate-load-perf-scenarios.mjs",
    "docs:generate": "node catalog/sync.mjs",
    "coverage:generate": "node scripts/generate-api-coverage.mjs",
    "coverage:generate-all": "node scripts/generate-api-coverage.mjs && node scripts/generate-remaining-coverage.mjs",
    "perf:catalog": "node scripts/generate-perf-catalog.mjs",
    "catalog:check": "node catalog/sync.mjs --check",
    "control-plane": "node control-plane/server.js",
    "control-plane:dev": "node --watch control-plane/server.js",
    "atp": "node runner/cli.mjs",
    "run": "node runner/cli.mjs run",
    "run:smoke": "node runner/cli.mjs run --suite smoke",
    "run:smoke:dry": "node runner/cli.mjs run --suite smoke --dry-run",
    "run:platform": "node runner/cli.mjs run --suite platform-gates",
    "run:sales": "node runner/cli.mjs run --suite sales-api-core",
    "run:org": "node runner/cli.mjs run --suite org-api-core",
    "run:ui": "node runner/cli.mjs run --suite ui-smoke",
    "run:ui-platform": "node runner/cli.mjs run --suite ui-platform",
    "run:ui-sales": "node runner/cli.mjs run --suite ui-sales",
    "run:sales-core": "node runner/cli.mjs run --suite sales-core",
    "run:e2e": "node runner/cli.mjs run --suite e2e-critical",
    "run:public": "node runner/cli.mjs run --suite public-smoke",
    "run:helpdesk": "node runner/cli.mjs run --suite helpdesk-core",
    "run:quotes": "node runner/cli.mjs run --suite quotes-core",
    "run:security": "node runner/cli.mjs run --suite security",
    "run:async-import": "node runner/cli.mjs run --suite async-import",
    "run:async-cron": "node runner/cli.mjs run --suite async-cron",
    "run:api-breadth": "node runner/cli.mjs run --suite api-breadth",
    "run:nightly": "node runner/cli.mjs run --suite nightly",
    "run:full": "node runner/cli.mjs run --suite full",
    "run:full-all": "node runner/cli.mjs run --suite full-all",
    "run:load": "node runner/cli.mjs run --suite load-smoke",
    "run:load:full": "node runner/cli.mjs run --suite load-full",
    "run:perf": "node runner/cli.mjs run --suite perf-api",
    "run:perf:full": "node runner/cli.mjs run --suite perf-full",
    "run:load-perf": "node runner/cli.mjs run --suite load-perf",
    "playwright:install": "playwright install chromium",
    "worker": "node control-plane/worker.js",
    "dashboard:dev": "npm run dev --prefix dashboard",
    "dashboard:build": "npm run build --prefix dashboard",
    "dev": "concurrently -n cp,dash -c blue,magenta \"npm run control-plane:dev\" \"npm run dashboard:dev\"",
    "stack:up": "docker compose -f docker-compose.atp.yml up -d",
    "stack:down": "docker compose -f docker-compose.atp.yml down",
    "postinstall": "npm install --prefix dashboard || true"
  },
  "dependencies": {
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "cron": "^4.3.0",
    "mongoose": "^8.19.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "playwright": "^1.60.0"
  }
}
