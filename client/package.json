{
  "name": "client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-s type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "NODE_OPTIONS=--max-old-space-size=7168 vite build",
    "build:chunks": "vite build && du -h dist/assets/*.js | sort -hr",
    "type-check": "NODE_OPTIONS=--max-old-space-size=7168 vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "i18n:extract": "node scripts/i18n/extract.mjs",
    "i18n:extract:check": "node scripts/i18n/extract.mjs --fail-on-missing",
    "i18n:lint": "node scripts/i18n/lint.mjs",
    "i18n:validate": "node scripts/i18n/validate.mjs",
    "i18n:find-hardcoded": "node scripts/i18n/find-hardcoded.mjs --scoped",
    "i18n:sync-keys": "node scripts/i18n/sync-locale-keys.mjs",
    "i18n:sync-keys:check": "node scripts/i18n/sync-locale-keys.mjs --check",
    "i18n:add-language": "node scripts/i18n/add-language.mjs",
    "i18n:check": "run-s i18n:sync-keys:check i18n:validate i18n:lint i18n:eslint-composables:test i18n:eslint-composables i18n:extract:check",
    "i18n:eslint-composables": "eslint -c eslint.i18n-composables.config.ts \"src/**/*.js\" \"src/composables/**/*.ts\" \"src/**/composables/**/*.ts\" --no-warn-ignored",
    "i18n:eslint-composables:test": "node eslint/rules/i18n-no-module-scope-use-i18n.test.mjs",
    "i18n:report": "node scripts/i18n/report.mjs",
    "i18n:report:json": "node scripts/i18n/report.mjs --json",
    "i18n:baseline": "node scripts/i18n/report.mjs --write-baseline",
    "i18n:mirror-locales": "node scripts/i18n/mirror-locales.mjs",
    "i18n:merge-keys": "node scripts/i18n/merge-locale-keys.mjs",
    "i18n:migrate-remaining": "node scripts/i18n/run-remaining-migrations.mjs",
    "i18n:migrate-second-pass": "node scripts/i18n/run-second-pass.mjs",
    "i18n:migrate-final-vue": "node scripts/i18n/run-final-vue-migrations.mjs",
    "i18n:ensure-useI18n": "node scripts/i18n/ensure-useI18n.mjs",
    "i18n:prune-orphans": "node scripts/i18n/prune-orphaned-keys.mjs",
    "i18n:translate-fr": "node scripts/i18n/translate-locale.mjs fr",
    "i18n:translate-de": "node scripts/i18n/translate-locale.mjs de",
    "i18n:translate-hi": "node scripts/i18n/translate-locale.mjs hi",
    "i18n:translate-phase-b": "npm run i18n:translate-fr && npm run i18n:translate-de && npm run i18n:translate-hi",
    "i18n:translate-locale": "node scripts/i18n/translate-locale.mjs",
    "i18n:translate-es": "node scripts/i18n/translate-locale.mjs es",
    "i18n:translate-es-gaps": "node scripts/i18n/apply-es-gap-translations.mjs",
    "i18n:apply-phase-ab": "node scripts/i18n/apply-phase-ab-translations.mjs --all",
    "i18n:apply-phase-ab-full": "node scripts/i18n/apply-phase-ab-translations.mjs --all --full-records",
    "i18n:apply-cognates": "node scripts/i18n/apply-cognate-patches.mjs",
    "i18n:rename-assign-rules-keys": "node scripts/i18n/rename-assign-rules-cond-keys.mjs"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/list": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@fullcalendar/vue3": "^6.1.19",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@sentry/vue": "^8.47.0",
    "@tanstack/vue-virtual": "^3.13.26",
    "@tiptap/extension-bubble-menu": "^2.18.0",
    "@tiptap/extension-heading": "^2.18.0",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.18.0",
    "@tiptap/extension-placeholder": "^2.18.0",
    "@tiptap/extension-task-item": "^2.18.0",
    "@tiptap/extension-task-list": "^2.18.0",
    "@tiptap/pm": "^2.18.0",
    "@tiptap/starter-kit": "^2.18.0",
    "@tiptap/suggestion": "^2.18.0",
    "@tiptap/vue-3": "^2.18.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "chart.js": "^4.4.0",
    "dompurify": "^3.2.3",
    "echarts": "^6.1.0",
    "emoji-picker-element": "^1.29.1",
    "googleapis": "^144.0.0",
    "grapesjs": "^0.23.2",
    "grapesjs-blocks-basic": "^1.0.2",
    "grapesjs-preset-newsletter": "^1.0.2",
    "grapesjs-preset-webpage": "^1.0.3",
    "gridstack": "^12.3.3",
    "js-beautify": "^2.0.3",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.55.1",
    "pinia": "^2.3.1",
    "posthog-js": "^1.255.0",
    "vue": "^3.5.22",
    "vue-chartjs": "^5.3.0",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.4",
    "vue-router": "^4.6.3",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.6",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.33.0",
    "eslint-plugin-oxlint": "~1.11.0",
    "eslint-plugin-vue": "~10.4.0",
    "fast-glob": "^3.3.3",
    "intl-messageformat": "^11.2.6",
    "jiti": "^2.5.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.11.0",
    "playwright": "^1.49.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.7",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.0"
  }
}
